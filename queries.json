{
  "faturadas": "SELECT\nFAT.CODIGO,\nFAT.TIPOFATURAMENTO,\n\nEMP.NOMEFANTASIA AS 'EMPRESA',\nCLI.APELIDO AS 'APELIDO CLIENTE',\n(SELECT (CASE K_PONTOATENDIMENTO WHEN 35 THEN 'REEMBOLSO'WHEN 36 THEN 'AUDITORIA'WHEN 33 THEN 'POSTO EMBRAPA'WHEN 27 THEN 'POSTO ITAIPU' \n\t\t\t\t\t\t\t\tWHEN 30 THEN 'POSTO BB' WHEN 3 THEN 'CAIXA' WHEN 4 THEN 'CAIXA BH' WHEN 19 THEN 'POSTO PETROBRAS' \n\t\t\t\t\t\t\t\tWHEN 26 THEN 'POSTO PETROBRAS' WHEN 20 THEN 'POSTO GDF' WHEN 17 THEN 'POSTO MPDG E DERIVADOS' \n\t\t\t\t\t\t\t\tWHEN 28 THEN 'POSTO MPDG E DERIVADOS' WHEN 29 THEN 'POSTO MPDG E DERIVADOS' WHEN 31 THEN 'POSTO MPDG E DERIVADOS' \n\t\t\t\t\t\t\t\tWHEN 32 THEN 'POSTO MPDG E DERIVADOS' WHEN 34 THEN 'POSTO MPDG E DERIVADOS' WHEN 23 THEN 'POSTO BNDES' \n\t\t\t\t\t\t\t\tWHEN 24 THEN 'POSTO FURNAS' ELSE 'DEMAIS CLIENTES' END) from BennerSistemaCorporativo.dbo. GN_PESSOAS WHERE HANDLE = CLI.HANDLE) AS 'PONTO_ATENDIMENTO',\nCASE \nWHEN FAT.STATUS = 1 THEN 'NOVA'\nWHEN FAT.STATUS = 2 THEN 'CADASTRADA'\nWHEN FAT.STATUS = 3 THEN 'GERADA'\nWHEN FAT.STATUS = 4 THEN 'EMITIDA'\nWHEN FAT.STATUS = 5 THEN 'CANCELADA'\nWHEN FAT.STATUS = 6 THEN 'LIQUIDADA'\nEND AS  'STATUS',\nCONVERT(VARCHAR(12),FAT.DATA,103) AS 'DATA EMISSAO',\nCONVERT(VARCHAR(12),FAT.DATACONFIRMACAO,103) AS 'DATA CONFIRMACAO',\nCONVERT(VARCHAR(12),PAR.VCTOPRORROGADO,103) AS 'VENCTO PRORROGADO',\nCONVERT(VARCHAR(12),PAR.DATALIQUIDACAO,103) AS 'DATA LIQUIDACAO',\nPAR.VALOR AS 'VAL. LIQUIDO', \nPAR.VALORESBAIXADOS AS 'VALOR BAIXADO',\n(SELECT NOME from BennerSistemaCorporativo.dbo. Z_GRUPOUSUARIOS USU WHERE USU.HANDLE = FAT.CONFIRMADOPOR) AS 'NOME FATURISTA'\nfrom BennerSistemaCorporativo.dbo. BB_FATURAS FAT\nINNER join BennerSistemaCorporativo.dbo. FILIAIS FIL ON FIL.HANDLE = FAT.FILIAL\nINNER join BennerSistemaCorporativo.dbo. EMPRESAS EMP ON EMP.HANDLE = FIL.EMPRESA\nINNER join BennerSistemaCorporativo.dbo. GN_PESSOAS CLI ON CLI.HANDLE = FAT.CLIENTE\nINNER join BennerSistemaCorporativo.dbo. FN_DOCUMENTOS DOC ON DOC.HANDLE = FAT.DOCUMENTOFATURA\nINNER join BennerSistemaCorporativo.dbo. FN_PARCELAS PAR ON  PAR.DOCUMENTO = DOC.HANDLE\nWHERE\nEMP.HANDLE IN ('3','7')\n--AND FAT.STATUS = '3'\n--AND PAR.VALORESBAIXADOS = '0'\n--and FAT.CODIGO in ('01330486')",
